<script>
  // 🔔 Show notification (Instagram style)
  function showNotification(message) {
    const box = document.getElementById("notificationBox");
    box.innerText = "🔔 " + message;
    box.style.display = "block";

    setTimeout(() => {
      box.style.display = "none";
    }, 4000);
  }

  // ⏰ Meal schedule (24-hour format)
  const mealTimes = [
    { time: "07:30", message: "Breakfast and morning tea is ready 🍳" },
    { time: "12:00", message: "Lunch is ready 🍛" },
    { time: "16:00", message: "Evening Tea is ready ☕" },
    { time: "19:30", message: "Dinner is ready 🍽️" }
  ];

  // 🧠 Check current time every minute
  setInterval(() => {
    const now = new Date();
    const currentTime =
      now.getHours().toString().padStart(2, '0') + ":" +
      now.getMinutes().toString().padStart(2, '0');

    mealTimes.forEach(meal => {
      if (meal.time === currentTime) {
        showNotification(meal.message);
      }
    });
  }, 60000); // check every 60 seconds

  // 🌟 SPECIAL MEAL (can be triggered anytime)
  function specialMeal(message) {
    showNotification("Special: " + message + " 🎉");
  }
</script>